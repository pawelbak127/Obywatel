# Skopiuj do .env.local i uzupelnij wartosciami z Supabase:
#   Project Settings -> API
#
# UWAGA: .env.local jest w .gitignore. SUPABASE_SERVICE_ROLE_KEY omija RLS -
# jesli trafi do repozytorium, kazdy moze nadpisac cala baze faktow.

# --- publiczne, trafiaja do przegladarki ---
#
# UWAGA na format adresu. Ma to byc SAM adres projektu, bez zadnej sciezki:
#   DOBRZE:  https://xxxxxxxxxxxx.supabase.co
#   ZLE:     https://xxxxxxxxxxxx.supabase.co/rest/v1/
#
# supabase-js doklada "/rest/v1/" samodzielnie. Ze sciezka w zmiennej kazde
# zapytanie idzie na /rest/v1/rest/v1/... i wraca 404 PGRST125 — blad, ktory
# wyglada jak problem z uprawnieniami i potrafi zjesc godzine.
# W panelu Supabase: Project Settings > API > "Project URL".
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- wylacznie serwer i skrypty importu ---
SUPABASE_SERVICE_ROLE_KEY=

# --- do generowania typow (npm run db:types) ---
SUPABASE_PROJECT_ID=

# --- Sprint 5 ---
# ANTHROPIC_API_KEY=
